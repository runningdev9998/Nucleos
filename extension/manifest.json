{
  "manifest_version": 3,
  "name": "Khan Academy Auto Sign-in",
  "version": "1.0.0",
  "description": "Signs in to Khan Academy with configured credentials and reports the real outcome.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.khanacademy.org/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.khanacademy.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
